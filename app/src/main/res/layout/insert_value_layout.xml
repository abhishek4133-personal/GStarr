<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chart_background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_chart_screen_header"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/khela_common_back"
            android:padding="@dimen/spacing_medium"
            android:src="@drawable/ic_khela_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/khela_insert_title"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingTop="@dimen/spacing_standard"
            android:paddingBottom="@dimen/spacing_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_standard"
                    android:layout_marginEnd="@dimen/spacing_standard"
                    app:cardBackgroundColor="@color/chart_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/spacing_large"
                        android:paddingTop="@dimen/spacing_large"
                        android:paddingEnd="@dimen/spacing_large"
                        android:paddingBottom="@dimen/spacing_large">

                        <TextView
                            android:id="@+id/slot_count"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/app_header"
                            android:textSize="13sp"
                            tools:text="3 of 8 slots added" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_tiny"
                            android:text="@string/khela_insert_subtitle"
                            android:textColor="@color/header4"
                            android:textSize="14sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/KhelaLoginTextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_large"
                            android:hint="@string/khela_insert_patti_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/patti_edit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:maxLength="3"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:textColor="@color/header1"
                                android:textSize="20sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:id="@+id/preview_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_standard"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/patti"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/spacing_small"
                                android:layout_weight="1"
                                android:background="@drawable/bg_insert_preview"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:paddingStart="@dimen/spacing_standard"
                                android:paddingTop="@dimen/spacing_small"
                                android:paddingEnd="@dimen/spacing_standard"
                                android:paddingBottom="@dimen/spacing_small"
                                android:textColor="@color/app_header"
                                android:textSize="14sp"
                                tools:text="Patti · 259" />

                            <TextView
                                android:id="@+id/pattiValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_insert_preview"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:paddingStart="@dimen/spacing_standard"
                                android:paddingTop="@dimen/spacing_small"
                                android:paddingEnd="@dimen/spacing_standard"
                                android:paddingBottom="@dimen/spacing_small"
                                android:textColor="@color/app_header"
                                android:textSize="14sp"
                                tools:text="Single · 6" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/submit"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="@dimen/spacing_large"
                            android:backgroundTint="@color/insert_submit"
                            app:backgroundTint="@color/insert_submit"
                            android:enabled="false"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/khela_insert_submit"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            app:cornerRadius="14dp"
                            app:rippleColor="@color/ripple_on_primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_large"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginEnd="@dimen/spacing_large"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/khela_insert_today"
                    android:textColor="@color/header1"
                    android:textSize="16sp" />

                <include
                    android:id="@+id/today_chart_card"
                    layout="@layout/referral_item_layout" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_standard"
                    android:layout_marginEnd="@dimen/spacing_standard"
                    android:layout_marginBottom="@dimen/spacing_standard"
                    app:cardBackgroundColor="@color/chart_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:id="@+id/changePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_standard"
                        android:paddingTop="@dimen/spacing_standard"
                        android:paddingEnd="@dimen/spacing_standard"
                        android:paddingBottom="@dimen/spacing_standard">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/khela_insert_change_password"
                            android:src="@drawable/ic_khela_lock"
                            android:tint="@color/app_header" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_standard"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/khela_insert_change_password"
                            android:textColor="@color/header1"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/khela_insert_change_password"
                            android:rotation="180"
                            android:src="@drawable/ic_khela_back"
                            android:tint="@color/header4" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/insert_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_admin_login_overlay"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/app_header" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
