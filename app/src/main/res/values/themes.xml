<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Khela" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/chart_accent</item>
        <item name="colorSecondaryVariant">@color/chart_accent</item>
        <item name="colorOnSecondary">@color/header1</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/app_header</item>
        <item name="android:windowBackground">@color/chart_background</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/app_footer</item>
    </style>

    <style name="Theme.Khela.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/app_header</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <style name="Theme.Khela.Detail" parent="Theme.Khela.NoActionBar">
        <item name="android:windowSharedElementEnterTransition">@transition/khela_shared</item>
        <item name="android:windowSharedElementReturnTransition">@transition/khela_shared</item>
        <item name="android:windowEnterTransition">@transition/khela_detail_enter</item>
        <item name="android:windowReturnTransition">@transition/khela_detail_return</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="l">true</item>
    </style>

    <style name="Theme.Khela.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Khela.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
