<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_standard"
    android:layout_marginEnd="@dimen/spacing_standard"
    app:cardBackgroundColor="@color/chart_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    android:layout_marginHorizontal="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/dateHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_chart_date"
            android:paddingStart="@dimen/spacing_standard"
            android:paddingEnd="@dimen/spacing_standard">

            <ImageView
                android:id="@+id/calendarIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/khela_chart_title"
                android:src="@drawable/ic_khela_calendar" />

            <TextView
                android:id="@+id/todayDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_toEndOf="@id/calendarIcon"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="02 Sep 2024" />

            <TextView
                android:id="@+id/weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:shadowColor="#4D000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Monday" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/numbersArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_small"
            android:paddingTop="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_medium">

            <LinearLayout
                android:id="@+id/chip_1"
                style="@style/KhelaChartColumn">
                <TextView android:id="@+id/ref_head_1" style="@style/KhelaChartPatti" android:text="@string/khela_chart_empty_slot" />
                <TextView android:id="@+id/ref_1" style="@style/KhelaChartSingle" android:text="@string/khela_chart_empty_slot" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/chip_2"
                style="@style/KhelaChartColumn">
                <TextView android:id="@+id/ref_head_2" style="@style/KhelaChartPatti" android:text="@string/khela_chart_empty_slot" />
                <TextView android:id="@+id/ref_2" style="@style/KhelaChartSingle" android:text="@string/khela_chart_empty_slot" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/chip_3"
                style="@style/KhelaChartColumn">
                <TextView android:id="@+id/ref_head_3" style="@style/KhelaChartPatti" android:text="@string/khela_chart_empty_slot" />
                <TextView android:id="@+id/ref_3" style="@style/KhelaChartSingle" android:text="@string/khela_chart_empty_slot" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/chip_4"
                style="@style/KhelaChartColumn">
                <TextView android:id="@+id/ref_head_4" style="@style/KhelaChartPatti" android:text="@string/khela_chart_empty_slot" />
                <TextView android:id="@+id/ref_4" style="@style/KhelaChartSingle" android:text="@string/khela_chart_empty_slot" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/chip_5"
                style="@style/KhelaChartColumn">
                <TextView android:id="@+id/ref_head_5" style="@style/KhelaChartPatti" android:text="@string/khela_chart_empty_slot" />
                <TextView android:id="@+id/ref_5" style="@style/KhelaChartSingle" android:text="@string/khela_chart_empty_slot" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/chip_6"
                style="@style/KhelaChartColumn">
                <TextView android:id="@+id/ref_head_6" style="@style/KhelaChartPatti" android:text="@string/khela_chart_empty_slot" />
                <TextView android:id="@+id/ref_6" style="@style/KhelaChartSingle" android:text="@string/khela_chart_empty_slot" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/chip_7"
                style="@style/KhelaChartColumn">
                <TextView android:id="@+id/ref_head_7" style="@style/KhelaChartPatti" android:text="@string/khela_chart_empty_slot" />
                <TextView android:id="@+id/ref_7" style="@style/KhelaChartSingle" android:text="@string/khela_chart_empty_slot" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/chip_8"
                style="@style/KhelaChartColumn">
                <TextView android:id="@+id/ref_head_8" style="@style/KhelaChartPatti" android:text="@string/khela_chart_empty_slot" />
                <TextView android:id="@+id/ref_8" style="@style/KhelaChartSingle" android:text="@string/khela_chart_empty_slot" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
