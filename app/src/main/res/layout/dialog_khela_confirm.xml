<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_khela_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_large"
    android:paddingTop="@dimen/spacing_large"
    android:paddingEnd="@dimen/spacing_large"
    android:paddingBottom="@dimen/spacing_large">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_khela_dialog_icon">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/khela_detail_delete_confirm"
            android:src="@drawable/ic_khela_delete"
            android:tint="@color/khela_danger" />
    </FrameLayout>

    <TextView
        android:id="@+id/confirm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_standard"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/header1"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Delete result 3?" />

    <TextView
        android:id="@+id/confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/header4"
        android:textSize="14sp"
        tools:text="Remove patti 247 from this day. Later results will move up." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/confirm_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/spacing_small"
            android:layout_weight="1"
            android:background="@drawable/bg_khela_cancel_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/khela_detail_delete_cancel"
            android:textColor="@color/header1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/confirm_delete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:background="@drawable/bg_khela_danger_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/khela_detail_delete_confirm"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
